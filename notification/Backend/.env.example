# Tunease Notification Service - Environment Configuration
PORT=3001
# URL opened by the welcome email's Start Listening button
CLIENT_URL=https://tunease-music-service-latest.onrender.com
# Email Configuration (Either use EMAIL_PASS for Gmail App Password OR OAuth2)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
REFRESH_TOKEN=your_oauth_refresh_token
RABBIT_MQ_URL=amqps://user:password@host/vhost
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Redis Configuration (for email deduplication, idempotency, and rate limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Or full connection URL:
# REDIS_URL=redis://localhost:6379
