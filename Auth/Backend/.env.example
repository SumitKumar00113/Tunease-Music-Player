# Tunease Auth Service - Environment Configuration
PORT=3000
MONGO_URI=mongodb://localhost:27017/tunease-music-player-auth-service
JWT_ACCESS_TOKEN_SECRET_KEY=your_jwt_access_secret_key_here
JWT_REFRESH_TOKEN_SECRET_KEY=your_jwt_refresh_secret_key_here
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
CLIENT_URL=http://localhost:5175
REFRESH_TOKEN=your_oauth_refresh_token
EMAIL_USER=your_email@gmail.com
RABBIT_MQ_URL=amqps://user:password@host/vhost
# Redis Configuration (for session caching, profile caching, and token revocation)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Or full connection URL:
# REDIS_URL=redis://localhost:6379
