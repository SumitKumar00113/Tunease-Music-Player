# Build from Auth/Backend: docker build -t tunease-auth .
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

# Install only runtime dependencies, using the lockfile for reproducible builds.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# .dockerignore excludes local dependencies, environment files, and generated files.
COPY --chown=node:node . .

USER node

# Override PORT at runtime if the service is configured to use another port.
EXPOSE 3000

# Provide secrets and service URLs at runtime (for example with --env-file); do not bake .env into the image.
CMD ["node", "server.js"]
