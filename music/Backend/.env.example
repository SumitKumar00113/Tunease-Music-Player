# Tunease Music Service - Environment Configuration
PORT=3002
MONGO_URI=mongodb://localhost:27017/tunease-music-player-music
# ImageKit media storage (server-side upload)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
# Optional public key, not used by the server-side upload flow.
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
# Temporary compatibility for existing S3 records. Remove once migration is complete.
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
JWT_ACCESS_TOKEN_SECRET_KEY=your_jwt_access_secret_key_matching_auth_service
SPOTIFY_ACCESS_TOKEN=replace_with_a_valid_spotify_access_token
# Redis Configuration (for music catalogue and playlist caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Upload limits are enforced by the music API: 20 MiB audio, 5 MiB cover image.
# Or full connection URL:
# REDIS_URL=redis://localhost:6379
