# Tunease Music Service - Environment Configuration
PORT=3002
MONGO_URI=mongodb://localhost:27017/tunease-music-player-music
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
JWT_ACCESS_TOKEN_SECRET_KEY=your_jwt_access_secret_key_matching_auth_service
SPOTIFY_ACCESS_TOKEN=replace_with_a_valid_spotify_access_token
# Redis Configuration (for music catalogue and playlist caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Or full connection URL:
# REDIS_URL=redis://localhost:6379
