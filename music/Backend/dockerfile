# Stage 1: Build TypeScript
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies needed for compiling TypeScript
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and build backend dist
COPY . .
RUN npm run build

# Stage 2: Production runtime
FROM node:22-alpine AS runner

ENV NODE_ENV=production
WORKDIR /app

# Install only production dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy the compiled backend. Public assets are optional for this API service.
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./

# Run as secure non-root user
USER node

# Music service port (default 3002)
EXPOSE 3002

CMD ["node", "dist/server.js"]
